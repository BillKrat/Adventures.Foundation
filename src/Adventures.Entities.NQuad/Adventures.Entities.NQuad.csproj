<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The composition layer between the feature libraries and the N-Quad store: each feature's entity repositories are registered here, once, so no host lists them (R2 of the host reuse review). -->
  <ItemGroup>
    <ProjectReference Include="..\Adventures.Data.NQuad\Adventures.Data.NQuad.csproj" />
    <ProjectReference Include="..\Adventures.Entities\Adventures.Entities.csproj" />
    <ProjectReference Include="..\Adventures.Entities.Identity\Adventures.Entities.Identity.csproj" />
    <ProjectReference Include="..\Adventures.Entities.Diagnostics\Adventures.Entities.Diagnostics.csproj" />
    <ProjectReference Include="..\Adventures.Blog\Adventures.Blog.csproj" />
    <ProjectReference Include="..\Adventures.Collaboration\Adventures.Collaboration.csproj" />
    <ProjectReference Include="..\Adventures.MEF\Adventures.MEF.csproj" />
  </ItemGroup>

</Project>
