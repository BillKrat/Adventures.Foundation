<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<PackageId>Adventures.Data.NQuad</PackageId>
	<Version>0.1.0</Version>
	<Authors>Bill Kratochvil</Authors>
	<Description>W3C N-Quads storage over PostgreSQL - standalone, in-parallel replacement for the JSONB Hybrid plus N-Quads model in Adventures.Data, built from the nquad-end-to-end-poc.</Description>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
	<PackageTags>postgres;nquads;rdf;data-access</PackageTags>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Npgsql" Version="9.0.3" />
	<PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>

  <ItemGroup>
	<None Include="Sql\**\*.sql" Pack="true" PackagePath="contentFiles\any\any\Sql\%(RecursiveDir)%(Filename)%(Extension)">
	  <PackageBuildAction>None</PackageBuildAction>
	</None>
	<None Include="Sql\**\*.nq" Pack="true" PackagePath="contentFiles\any\any\Sql\%(RecursiveDir)%(Filename)%(Extension)">
	  <PackageBuildAction>None</PackageBuildAction>
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
  </ItemGroup>

</Project>

