<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<PackageId>Adventures.Data</PackageId>
	<Version>0.2.1</Version>
	<Authors>Bill Kratochvil</Authors>
	<Description>Generic, tenant/org-scoped entity data access (JSONB Hybrid + W3C N-Quads storage model) over PostgreSQL - shared data foundation for Adventures.* projects.</Description>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
	<PackageTags>postgres;jsonb;multi-tenant;data-access</PackageTags>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Npgsql" Version="9.0.3" />
	<PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>

  <ItemGroup>
	<!-- PackagePath must not end in a trailing separator here: combined with the implicit
	     %(RecursiveDir) NuGet appends for a glob Include, a trailing separator produces a
	     doubled "//" in the nuspec's generated <files include> glob (e.g. "Sql//schema.sql"
	     instead of "Sql/schema.sql"), which then fails to match the actual packed path and
	     silently drops the buildAction="None" contentFiles metadata - the consuming project's
	     compiler then falls back to inferring a build action for the unrecognized ".sql"
	     extension, which defaults to Compile, and tries to build the SQL files as C# source. -->
	<None Include="Sql\**\*.sql" Pack="true" PackagePath="contentFiles\any\any\Sql\%(RecursiveDir)%(Filename)%(Extension)">
	  <PackageBuildAction>None</PackageBuildAction>
	</None>
  </ItemGroup>

</Project>
