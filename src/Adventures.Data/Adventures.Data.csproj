<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<PackageId>Adventures.Data</PackageId>
	<Version>0.2.2</Version>
	<Authors>Adventures On The Edge</Authors>
	<Description>Storage-neutral data contracts for Adventures.* projects: the entity record, the triple, and the repository and SQL-executor interfaces that a store (Adventures.Data.Postgres, Adventures.Data.NQuad) implements. Holds no database driver.</Description>
	<PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
	<PackageTags>data-access;abstractions</PackageTags>
  </PropertyGroup>

</Project>
