<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Adventures.Browser.Client</PackageId>
    <Version>0.1.0</Version>
    <Authors>Adventures On The Edge</Authors>
    <Description>What the schema browser applications share: the list of domains a person configured, a session per domain through the browser API, and the view models. No UI toolkit and no server framework.</Description>
    <PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
    <PackageTags>schema;browser;client;viewmodels</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adventures.Client\Adventures.Client.csproj" />
    <ProjectReference Include="..\Adventures.Entities\Adventures.Entities.csproj" />
  </ItemGroup>

</Project>
