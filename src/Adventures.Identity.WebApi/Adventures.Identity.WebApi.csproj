<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<PackageId>Adventures.Identity.WebApi</PackageId>
	<Version>0.1.0</Version>
	<Authors>Adventures On The Edge</Authors>
	<Description>ASP.NET Core controllers for identity: sign-in and machine-client tokens, the current profile, users, roles with their rights, lookups and the current tenant with its host aliases.</Description>
	<PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
	<PackageTags>identity;webapi;controllers</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adventures.Entities.Identity\Adventures.Entities.Identity.csproj" />
    <ProjectReference Include="..\Adventures.Identity\Adventures.Identity.csproj" />
    <ProjectReference Include="..\Adventures.WebApi\Adventures.WebApi.csproj" />
    <ProjectReference Include="..\Adventures.Security\Adventures.Security.csproj" />
  </ItemGroup>

</Project>
