<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<PackageId>Adventures.Blog.Postgres</PackageId>
	<Version>0.1.0</Version>
	<Authors>Adventures On The Edge</Authors>
	<Description>PostgreSQL storage for Adventures.Blog media (uploaded images in a table next to the data store).</Description>
	<PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
	<PackageTags>blog;postgres;media</PackageTags>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Npgsql" Version="9.0.3" />
	<PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adventures.Blog\Adventures.Blog.csproj" />
  </ItemGroup>

</Project>
