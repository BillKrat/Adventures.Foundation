<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Adventures.WebApi</PackageId>
    <Version>0.1.0</Version>
    <Authors>Adventures On The Edge</Authors>
    <Description>Reusable ASP.NET Core controller base classes for the Adventures.Entities CRUDL engine - the generic action bodies a new app's controllers call into, so spinning up CRUDL for a schema-driven entity is a small, concrete, attribute-decorated subclass rather than hand-written plumbing.</Description>
    <PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
    <PackageTags>webapi;controllers;entities;crudl</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adventures.Entities\Adventures.Entities.csproj" />
    <ProjectReference Include="..\Adventures.Entities.Diagnostics\Adventures.Entities.Diagnostics.csproj" />
    <ProjectReference Include="..\Adventures.Entities.Identity\Adventures.Entities.Identity.csproj" />
    <ProjectReference Include="..\Adventures.MEF\Adventures.MEF.csproj" />
    <ProjectReference Include="..\Adventures.Security\Adventures.Security.csproj" />
  </ItemGroup>

</Project>
