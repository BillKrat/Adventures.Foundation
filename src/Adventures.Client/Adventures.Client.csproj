<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<PackageId>Adventures.Client</PackageId>
	<Version>0.1.0</Version>
	<Authors>Adventures On The Edge</Authors>
	<Description>Desktop and console client for an Adventures.* API: sign in, hold the acting principal, and a remote entity presenter over the grid and form contract. No UI toolkit and no server framework.</Description>
	<PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
	<PackageTags>client;desktop;wpf;api</PackageTags>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Adventures.Entities\Adventures.Entities.csproj" />
	<ProjectReference Include="..\Adventures.Security\Adventures.Security.csproj" />
  </ItemGroup>

</Project>
