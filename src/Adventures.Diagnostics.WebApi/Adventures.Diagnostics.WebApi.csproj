<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<PackageId>Adventures.Diagnostics.WebApi</PackageId>
	<Version>0.1.0</Version>
	<Authors>Adventures On The Edge</Authors>
	<Description>ASP.NET Core controllers for observability: health (public and detailed), the exception log and its failure kinds, client-reported errors, and correlation-id diagnostics for administrators and machine clients.</Description>
	<PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
	<PackageTags>diagnostics;health;webapi;controllers</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adventures.Entities.Diagnostics\Adventures.Entities.Diagnostics.csproj" />
    <ProjectReference Include="..\Adventures.WebApi\Adventures.WebApi.csproj" />
    <ProjectReference Include="..\Adventures.Security\Adventures.Security.csproj" />
    <ProjectReference Include="..\Adventures.Tools\Adventures.Tools.csproj" />
  </ItemGroup>

</Project>
