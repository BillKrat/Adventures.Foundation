<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<PackageId>Adventures.Identity.Postgres</PackageId>
	<Version>0.1.0</Version>
	<Authors>Adventures On The Edge</Authors>
	<Description>PostgreSQL credential vault for Adventures.Identity: password hash, lockout and last-login state per user.</Description>
	<PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
	<PackageTags>identity;postgres</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adventures.Identity\Adventures.Identity.csproj" />
    <ProjectReference Include="..\Adventures.Data\Adventures.Data.csproj" />
  </ItemGroup>

</Project>
