<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Adventures.Browser.WebApi</PackageId>
    <Version>0.1.0</Version>
    <Authors>Adventures On The Edge</Authors>
    <Description>Read-only schema browser routes a site publishes for the schema browser applications: the shape of the data, never the data. Off unless the host switches it on; every route needs the schema.read right.</Description>
    <PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
    <PackageTags>schema;browser;webapi</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adventures.Entities\Adventures.Entities.csproj" />
    <ProjectReference Include="..\Adventures.Entities.Identity\Adventures.Entities.Identity.csproj" />
    <ProjectReference Include="..\Adventures.WebApi\Adventures.WebApi.csproj" />
  </ItemGroup>

</Project>
