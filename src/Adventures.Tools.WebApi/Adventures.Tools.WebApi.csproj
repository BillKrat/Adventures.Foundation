<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<PackageId>Adventures.Tools.WebApi</PackageId>
	<Version>0.1.0</Version>
	<Authors>Adventures On The Edge</Authors>
	<Description>The tool manifest endpoint: GET /api/tools lists the tools the caller token and the enabled plug-ins allow, GET /api/tools/find picks one for a search key through the replaceable selector.</Description>
	<PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
	<PackageTags>tools;webapi;controllers</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adventures.Tools\Adventures.Tools.csproj" />
    <ProjectReference Include="..\Adventures.MEF\Adventures.MEF.csproj" />
  </ItemGroup>

</Project>
