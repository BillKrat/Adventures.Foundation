<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<PackageId>Adventures.Collaboration</PackageId>
	<Version>0.1.0</Version>
	<Authors>Adventures On The Edge</Authors>
	<Description>Collaboration feature for Adventures.* applications: Developer and Research collaboration items with review states, the shared conversation (comments and decisions), and the authoring surface for AI collaborators.</Description>
	<PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
	<PackageTags>collaboration;review</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adventures.Entities\Adventures.Entities.csproj" />
    <ProjectReference Include="..\Adventures.MEF\Adventures.MEF.csproj" />
  </ItemGroup>

</Project>
