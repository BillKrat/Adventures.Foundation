<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
	<PackageId>Adventures.Blog.Legacy</PackageId>
	<Version>0.1.0</Version>
	<Authors>Adventures On The Edge</Authors>
	<Description>Runs Adventures.Blog on an existing BlogEngine.NET SQL Server database: data-access layers for posts, pages, categories and tags over the be_* tables. Registering them instead of the N-Quad ones is the whole switch (Data:Mode=Legacy).</Description>
	<PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
	<RepositoryUrl>https://github.com/BillKrat/Adventures.Foundation</RepositoryUrl>
	<PackageTags>blog;blogengine;sqlserver</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adventures.Blog\Adventures.Blog.csproj" />
    <ProjectReference Include="..\Adventures.Data.Sql\Adventures.Data.Sql.csproj" />
  </ItemGroup>

</Project>
