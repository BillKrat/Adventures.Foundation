<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local folder feed for iterating on Adventures.* packages before a real nuget.org release.
         Not committed as package content itself - just a package source pointer. Sibling folder to
         this repo and its consumers (e.g. M:\Dev\repos\Adventures.Foundation, \ai-research-blog). -->
    <add key="adventures-local" value="../local-nuget-feed" />
  </packageSources>
</configuration>
