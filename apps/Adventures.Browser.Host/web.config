<?xml version="1.0" encoding="utf-8"?>
<!--
  Checked in purely to set stdoutLogEnabled="true" -
  this service has no Serilog file sink of its own, so this is its only startup-crash diagnostic
  trail. dotnet publish's web.config transform merges into this file rather than overwriting it.

  Deliberately contains NO <environmentVariables> and no secrets - those live in this site's own
  IIS Application Pool Environment Variables (SmarterASP Advanced Tools -> Pool Manager), same
  convention as the other hosts.

  hostingModel is outofprocess so the host can sit in an application pool shared with other sites: IIS runs only one
  in-process ASP.NET Core application per pool (error 500.35), and a fault in its own process leaves the other sites
  running. A pool cannot mix the two models (error 500.34): every ASP.NET Core site in it must use the same one.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Adventures.Browser.Host.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess" />
    </system.webServer>
  </location>
</configuration>
