<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The schema browser applications' API: a gateway to the sites this installation configures. No store, no user store, no secrets: the tests of this
    host fail if a store or a feature library ever becomes reachable from it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Adventures.Browser.Gateway.WebApi\Adventures.Browser.Gateway.WebApi.csproj" />
    <ProjectReference Include="..\..\src\Adventures.WebApi\Adventures.WebApi.csproj" />
  </ItemGroup>

</Project>
