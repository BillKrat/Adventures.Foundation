<Window x:Class="Adventures.Browser.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adventures - Schema Browser" Width="1100" Height="700" MinWidth="720" MinHeight="440">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="12">
            <TextBlock DockPanel.Dock="Top" Text="Domains" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom">
                <TextBox Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,4" ToolTip="A domain you have access to, such as example.com" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add" Command="{Binding AddCommand}" Padding="12,2" Margin="0,0,8,0" />
                    <Button Content="Remove" Command="{Binding RemoveCommand}" Padding="12,2" />
                </StackPanel>
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Domains}" SelectedItem="{Binding SelectedDomain, Mode=TwoWay}" />
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="4" VerticalAlignment="Stretch" HorizontalAlignment="Center" />
        <ContentControl Grid.Column="2" Content="{Binding Current}" Margin="12" />
    </Grid>
</Window>
