<Application x:Class="Adventures.Browser.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Adventures.Browser.Client;assembly=Adventures.Browser.Client"
             xmlns:views="clr-namespace:Adventures.Browser.Desktop.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- A screen view model is shown by its view: MainWindow only displays BrowserShellViewModel.Current. -->
        <DataTemplate DataType="{x:Type vm:SiteSignInViewModel}"><views:SignInView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SchemaBrowserViewModel}"><views:SchemaBrowserView /></DataTemplate>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B00020" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
    </Application.Resources>
</Application>
